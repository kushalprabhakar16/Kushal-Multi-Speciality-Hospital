{
  "info": {
    "name": "Kushal Multi Speciality Hospital",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "kmsh-collection-0001",
    "description": "Postman collection for the Kushal Multi Speciality Hospital REST API.\n\nSet the {{baseUrl}} variable to your API URL (e.g. http://localhost:5000/api).\nAfter login, the {{token}} variable is set automatically for authenticated requests."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@kmsh.in\",\n  \"password\": \"password123\",\n  \"role\": \"Patient\"\n}" }
          }
        },
        {
          "name": "Login",
          "event": [
            { "listen": "test", "script": { "exec": ["var json = pm.response.json();", "if (json.token) { pm.collectionVariables.set('token', json.token); }"], "type": "text/javascript" } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@kmsh.in\",\n  \"password\": \"admin123\"\n}" }
          }
        },
        {
          "name": "Me",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/auth/me" }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        { "name": "List Patients", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/patients" } },
        { "name": "Get Patient", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/patients/KMSH-P-000001" } },
        { "name": "Create Patient", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/patients", "body": { "mode": "raw", "raw": "{\n  \"id\": \"KMSH-P-000099\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"gender\": \"Male\",\n  \"dob\": \"1990-01-01\",\n  \"phone\": \"9999999999\",\n  \"department\": \"Cardiology\",\n  \"status\": \"Pending\"\n}" } } },
        { "name": "Update Patient", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/patients/KMSH-P-000099", "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Smith\",\n  \"status\": \"Admitted\"\n}" } } },
        { "name": "Delete Patient", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/patients/KMSH-P-000099" } }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        { "name": "List Doctors", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/doctors" } },
        { "name": "Get Doctor", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/doctors/KMSH-D-000001" } },
        { "name": "Create Doctor", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/doctors", "body": { "mode": "raw", "raw": "{\n  \"id\": \"KMSH-D-000099\",\n  \"name\": \"Dr. Test\",\n  \"spec\": \"Cardiology\",\n  \"qual\": \"MD\",\n  \"department\": \"Cardiology\",\n  \"phone\": \"9999999999\"\n}" } } },
        { "name": "Delete Doctor", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/doctors/KMSH-D-000099" } }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        { "name": "List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/appointments" } },
        { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/appointments", "body": { "mode": "raw", "raw": "{\n  \"id\": \"KMSH-A-000099\",\n  \"patient\": \"Suresh Patel\",\n  \"patientId\": \"KMSH-P-000001\",\n  \"doctor\": \"Dr. Anjali Sharma\",\n  \"date\": \"2026-08-10\",\n  \"time\": \"10:00\",\n  \"reason\": \"Checkup\"\n}" } } },
        { "name": "Delete", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/appointments/KMSH-A-000099" } }
      ]
    },
    {
      "name": "Departments",
      "item": [
        { "name": "List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/departments" } },
        { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/departments", "body": { "mode": "raw", "raw": "{\n  \"id\": \"KMSH-DE-000099\",\n  \"name\": \"New Dept\",\n  \"status\": \"Active\"\n}" } } }
      ]
    },
    {
      "name": "Operations",
      "item": [
        { "name": "List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/operations" } },
        { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/operations", "body": { "mode": "raw", "raw": "{\n  \"id\": \"KMSH-S-000099\",\n  \"patient\": \"Fatima Sheikh\",\n  \"patientId\": \"KMSH-P-000004\",\n  \"leadDoctor\": \"Dr. Imran Khan\",\n  \"date\": \"2026-08-10\",\n  \"type\": \"Appendectomy\",\n  \"cost\": 25000\n}" } } }
      ]
    },
    {
      "name": "Laboratory",
      "item": [
        { "name": "List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/lab-tests" } },
        { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/lab-tests", "body": { "mode": "raw", "raw": "{\n  \"id\": \"KMSH-L-000099\",\n  \"patient\": \"Suresh Patel\",\n  \"patientId\": \"KMSH-P-000001\",\n  \"doctor\": \"Dr. Anjali Sharma\",\n  \"test\": \"Blood Test\",\n  \"date\": \"2026-08-04\"\n}" } } }
      ]
    },
    {
      "name": "Pharmacy",
      "item": [
        { "name": "List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/pharmacy" } },
        { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/pharmacy", "body": { "mode": "raw", "raw": "{\n  \"id\": \"KMSH-M-000099\",\n  \"name\": \"Ibuprofen 400mg\",\n  \"category\": \"Analgesic\",\n  \"supplier\": \"Cipla\",\n  \"qty\": 500,\n  \"price\": 8,\n  \"expiry\": \"2027-01-01\"\n}" } } }
      ]
    },
    {
      "name": "Billing",
      "item": [
        { "name": "List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/billing" } },
        { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/billing", "body": { "mode": "raw", "raw": "{\n  \"id\": \"KMSH-B-000099\",\n  \"patient\": \"Suresh Patel\",\n  \"patientId\": \"KMSH-P-000001\",\n  \"consultation\": 1200,\n  \"lab\": 500,\n  \"surgery\": 0,\n  \"pharmacy\": 300,\n  \"room\": 2000,\n  \"insurance\": 0,\n  \"discount\": 100,\n  \"total\": 3900,\n  \"paid\": 3900,\n  \"balance\": 0,\n  \"status\": \"Paid\"\n}" } } }
      ]
    },
    {
      "name": "Staff",
      "item": [
        { "name": "List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/staff" } },
        { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/staff", "body": { "mode": "raw", "raw": "{\n  \"id\": \"KMSH-ST-000099\",\n  \"name\": \"Jane Doe\",\n  \"role\": \"Nurse\",\n  \"department\": \"ICU\",\n  \"phone\": \"9999999999\",\n  \"joining\": \"2024-01-01\"\n}" } } }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        { "name": "List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/notifications" } },
        { "name": "Mark All Read", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/notifications/read-all" } }
      ]
    },
    {
      "name": "Upload",
      "item": [
        { "name": "Upload File", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/upload", "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] } } }
      ]
    },
    {
      "name": "Health",
      "item": [
        { "name": "Health Check", "request": { "method": "GET", "url": "{{baseUrl}}/health" } }
      ]
    }
  ]
}
